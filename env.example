# GEYSERPULS - Environment Variables Example
# Copy this file to .env and fill with your own values
# cp .env.example .env

# --- Server ---
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# --- Bitcoin / Lightning ---
# Use testnet for development, NEVER use mainnet keys here
BITCOIN_NETWORK=testnet
LIGHTNING_NODE_URL=http://localhost:10009
LIGHTNING_MACAROON_PATH=./.lnd/admin.macaroon
LIGHTNING_TLS_CERT_PATH=./.lnd/tls.cert

# --- Geyser Fund ---
GEYSER_API_URL=https://api.geyser.fund
GEYSER_API_KEY=your_geyser_api_key_here

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/geyserpuls

# --- Auth / Security ---
JWT_SECRET=change_this_to_a_long_random_secret
